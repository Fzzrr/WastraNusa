// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --------------- ENUM -----------------

enum Gender {
  male
  female
  unisex
}

enum ArticleStatus {
  draft
  published
  archived
}

enum ProductStatus {
  active
  inactive
  out_of_stock
}

enum VariantType {
  size
  color
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
}

enum PaymentStatus {
  unpaid
  paid
  failed
  refunded
}

enum PaymentTransactionStatus {
  pending
  success
  failed
  expired
}

enum SellerApplicationStatus {
  pending
  approved
  rejected
}

// --------------- Table -----------------

model User {
  id            String  @id
  name          String
  email         String
  emailVerified Boolean @default(false)
  image         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sessions  Session[]
  accounts  Account[]

  articles          Article[]         @relation("ArticleCreatedBy")
  customerAddresses CustomerAddress[]
  orders            Order[]
  userArticleLikes  UserArticleLike[]
  cart              Cart?

  // Seller feature
  sellerApplication    SellerApplication?  @relation("SellerApplicant")
  reviewedApplications SellerApplication[] @relation("ApplicationReviewer")
  products             Product[]           @relation("ProductSeller")
  sellerOrders         Order[]             @relation("OrderSeller")
  shopProfile          ShopProfile?        @relation("ShopOwner")

  // Live chat (1-on-1). A user sits on either side of a conversation.
  conversationsInitiated Conversation[] @relation("ConversationParticipantOne")
  conversationsReceived  Conversation[] @relation("ConversationParticipantTwo")
  sentMessages           Message[]      @relation("MessageSender")

  role       String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  phoneNumber String?
  gender      String?
  birthDate   DateTime?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Article {
  id          String  @id
  title       String
  slug        String  @unique
  description String?
  excerpt     String

  province    String?
  island      String?
  region      String
  topic       String
  ethnicGroup String?

  clothingType String?
  motifLabel   String
  gender       Gender?
  readMinutes  Int     @default(6)
  featured     Boolean @default(false)

  imageURL String?

  summary String?

  sections ArticleSection[]

  status    ArticleStatus @default(published)
  createdBy String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relations
  creator    User               @relation("ArticleCreatedBy", fields: [createdBy], references: [id])
  products   Product[]
  engagement ArticleEngagement?
  userLikes  UserArticleLike[]

  @@index([province])
  @@index([ethnicGroup])
  @@index([clothingType])
  @@index([status, province])
  @@map("article")
}

model Product {
  id          String  @id
  articleId   String
  sellerId    String?
  name        String
  slug        String  @unique
  description String?

  price Decimal
  sku   String  @unique

  weight Int

  island       String
  province     String
  clothingType String
  gender       Gender?

  status ProductStatus @default(active)
  sold   Int           @default(0)

  imageURL String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  article   Article          @relation(fields: [articleId], references: [id], onDelete: Restrict)
  seller    User?            @relation("ProductSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  variants  ProductVariant[]
  orders    Order[]
  cartItems CartItem[]

  @@index([island])
  @@index([province])
  @@index([clothingType])
  @@index([gender])
  @@index([sellerId])
  @@map("product")
}

model ProductVariant {
  id        String @id
  productId String

  name  String
  type  VariantType
  price Decimal?
  stock Int         @default(0)
  sku   String      @unique

  imageURL String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders    Order[]
  cartItems CartItem[]

  @@index([type])
  @@map("product_variant")
}

model CustomerAddress {
  id String @id

  userId String

  label         String
  recipientName String
  phone         String

  province    String
  city        String
  district    String
  subdistrict String?
  postalCode  String
  fullAddress String

  notes     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("customer_address")
}

model Order {
  id String @id

  orderNumber String @unique
  userId      String

  productId    String
  variantId    String?
  sellerId     String?
  productName  String
  variantName  String?
  quantity     Int
  productPrice Decimal

  shippingAddressId String

  courier           String
  courierService    String
  estimatedDelivery String?
  trackingNumber    String?

  subtotal     Decimal
  shippingCost Decimal
  totalAmount  Decimal

  orderStatus   OrderStatus   @default(pending)
  paymentStatus PaymentStatus @default(unpaid)
  paymentMethod String?

  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customerNotes String?

  // Relations
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  product             Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant             ProductVariant?      @relation(fields: [variantId], references: [id], onDelete: SetNull)
  seller              User?                @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  shippingAddress     CustomerAddress      @relation(fields: [shippingAddressId], references: [id], onDelete: Restrict)
  paymentTransactions PaymentTransaction[]

  @@index([userId])
  @@index([productId])
  @@index([sellerId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@map("order")
}

model PaymentTransaction {
  id         String                   @id
  orderId    String
  externalId String                   @unique
  amount     Decimal
  status     PaymentTransactionStatus

  paymentUrl String?
  vaNumber   String?
  qrCode     String?

  expiredAt DateTime?
  paidAt    DateTime?
  createdAt DateTime

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([externalId])
  @@index([status])
  @@map("payment_transaction")
}

model ArticleEngagement {
  id        String   @id
  articleId String   @unique
  viewCount Int      @default(0)
  likeCount Int      @default(0)
  updatedAt DateTime @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("article_engagement")
}

model UserArticleLike {
  id        String   @id
  articleId String
  userId    String
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([userId])
  @@map("user_article_like")
}

model Cart {
  id        String   @id
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("cart")
}

model CartItem {
  id        String   @id
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_item")
}

model ArticleSection {
  id           String  @id @default(uuid())
  articleId    String
  title        String
  content      String
  imageLabel   String?
  imageCaption String?
  imageURL     String?
  order        Int     @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("article_section")
}

model SellerApplication {
  id String @id

  userId String @unique
  user   User   @relation("SellerApplicant", fields: [userId], references: [id], onDelete: Cascade)

  shopName    String
  description String?
  phoneNumber String?

  status          SellerApplicationStatus @default(pending)
  rejectionReason String?

  reviewedById String?
  reviewer     User?     @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("seller_application")
}

/// A seller's public-facing shop profile. One-to-one with User; the row only
/// exists after a seller application is approved (the application data is
/// copied here on acceptance). Column lengths mirror the Zod restrictions in
/// `shop-profile.schema.ts` so the DB enforces the same bounds as the API.
model ShopProfile {
  id String @id

  userId String @unique
  user   User   @relation("ShopOwner", fields: [userId], references: [id], onDelete: Cascade)

  shopName    String  @db.VarChar(60)
  description String? @db.VarChar(500)
  phoneNumber String? @db.VarChar(20)
  email       String? @db.VarChar(120)
  address     String? @db.VarChar(255)
  city        String? @db.VarChar(60)
  province    String? @db.VarChar(60)
  logoURL     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shop_profile")
}

/// A 1-on-1 chat thread between exactly two users (no groups). Participants are
/// stored normalized with `participantOneId <= participantTwoId` so a given
/// pair maps to a single row regardless of who starts the conversation; the
/// `@@unique` enforces that at the DB level.
model Conversation {
  id String @id

  participantOneId String
  participantTwoId String
  participantOne   User @relation("ConversationParticipantOne", fields: [participantOneId], references: [id], onDelete: Cascade)
  participantTwo   User @relation("ConversationParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Cascade)

  // Mirrors the latest message time so conversation lists sort without a join.
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@unique([participantOneId, participantTwoId])
  @@index([participantOneId])
  @@index([participantTwoId])
  @@index([lastMessageAt])
  @@map("conversation")
}

/// A single message belonging to exactly one conversation, authored by one of
/// its two participants. `readAt` powers read receipts.
model Message {
  id String @id

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  content String @db.VarChar(2000)

  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("message")
}
